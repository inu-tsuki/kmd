{
  "name": "kmd",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @kmd/editor dev",
    "build": "pnpm language:check && pnpm core:check && pnpm language-server:build && pnpm vscode-kmd:build && pnpm editor:build",
    "preview": "pnpm --filter @kmd/editor preview",
    "test": "pnpm core:check && pnpm language-server:test && pnpm --filter @kmd/editor test",
    "test:parser": "pnpm --filter @kmd/editor test:parser",
    "test:playback": "pnpm --filter @kmd/editor test:playback",
    "test:invariants": "pnpm --filter @kmd/editor test:invariants",
    "test:shaders": "pnpm --filter @kmd/editor test:shaders",
    "test:golden:write": "pnpm --filter @kmd/editor test:golden:write",
    "test:e2e": "pnpm reader:build && pnpm test:e2e:run",
    "test:e2e:run": "node scripts/run-e2e.mjs",
    "language:sync": "node scripts/sync-language-assets.mjs",
    "language:check": "node scripts/check-language-assets.mjs",
    "language:test": "node --test scripts/test/language-assets.test.mjs",
    "core:typecheck": "pnpm --filter @kmd/core typecheck",
    "core:check": "pnpm --filter @kmd/core check",
    "language-server:build": "pnpm --filter @kmd/language-server build",
    "language-server:typecheck": "pnpm --filter @kmd/language-server typecheck",
    "language-server:test": "pnpm --filter @kmd/language-server test",
    "language-server:check": "pnpm --filter @kmd/language-server check",
    "vscode-kmd:build": "pnpm --filter vscode-kmd build",
    "vscode-kmd:typecheck": "pnpm --filter vscode-kmd typecheck",
    "editor:dev": "pnpm --filter @kmd/editor dev",
    "editor:build": "pnpm --filter @kmd/editor build",
    "editor:preview": "pnpm --filter @kmd/editor preview",
    "reader:typecheck": "pnpm --filter @kmd/reader-runtime-web typecheck",
    "reader:build": "pnpm --filter @kmd/reader-runtime-web build",
    "reader:preview": "pnpm --filter @kmd/reader-runtime-web preview",
    "community-api:dev": "pnpm --filter @kmd/community-api dev",
    "community-api:build": "pnpm --filter @kmd/community-api build",
    "community-api:test": "pnpm --filter @kmd/community-api test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
