{
  "kind": "macro-expansion",
  "documentEnd": 400,
  "variables": [
    { "name": "route", "value": "a", "range": { "start": 0, "end": 5 } },
    { "name": "enabled", "value": true, "range": { "start": 6, "end": 13 } }
  ],
  "objects": [
    { "name": "hero", "start": 20, "end": 300 }
  ],
  "macros": [
    { "source": "heading = .red -250ms-> wave", "offset": 40, "sceneEnd": 300 }
  ],
  "registry": [
    { "name": "red", "family": "style" },
    { "name": "gray", "family": "style" },
    { "name": "wave", "family": "effect" },
    { "name": "shake", "family": "effect" }
  ],
  "chain": "hero.$(var.route == 'a' ? heading : gray).$(var.enabled ? shake)",
  "chainOffset": 100
}
