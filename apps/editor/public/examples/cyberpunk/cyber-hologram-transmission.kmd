---
title: 示例 - 全息通讯断讯
mode: stage
speed: 46
designWidth: 1920
designHeight: 1080
bgColor: "#020913"
fontColor: "#bffcff"
fontFamily: monospace
---

// 镜头 1：信标从黑场中逐字上线。
@ bg(color="#020913")
@ cam.drift(4, 0.001)
{INCOMING TRANSMISSION} @ f.hologram:group(tint="#68f7ff", shadow="#03131f", scan=5, jitter=1.5, glow=1.3, radius=5, flicker=0.12, speed=1.2, float=1.5).digitalFlicker(rate=9, duty=0.12, intensity=0.5, minAlpha=0.45).big

{CHANNEL 7 :: ENCRYPTED} @ f.neonGlow:group(color="#ff3bd4", shadow="#16051d", strength=1.6, radius=6, pulse=0.24, speed=1.3)

---

// 镜头 2：全息角色投影，扫描、漂浮、RGB 抖动协同工作。
@ bg(color="#03101d")
@ cam.drift(8, 0.0018)
@ cam.zoom(0.88, 0.8s)!
[.hologram:block(tint="#66f7ff", shadow="#02101d", scan=6, jitter=3, glow=1.8, radius=7, flicker=0.18, speed=1.7, float=4)]
REMOTE AVATAR :: UNIT 07

{Can you hear me?} @ f.digitalFlicker(rate=15, duty=0.2, intensity=0.62, minAlpha=0.3).hologram:group(tint="#9fffff", scan=4, jitter=1, glow=0.9, flicker=0.08, speed=1.1, float=1)

---

// 镜头 3：干扰峰值把画面撕裂，并通过震动制造断讯冲击。
@ bg(color="#090414")
@ cam.drift(0)
@ cam.shake(11)
[.hologram:block(tint="#ff4bd8", shadow="#16031a", scan=8, jitter=7, glow=2.2, radius=8, flicker=0.34, speed=4.2, float=7) .cyberGlitch:block(rgb=28, frequency=12, burst=0.62, blockSize=20, noise=0.32, jitter=8)]
CONNECTION UNSTABLE

{PACKET LOSS: 87%} @ f.digitalFlicker(rate=30, duty=0.42, intensity=0.85, minAlpha=0.12).chromaticAberration:group(x=14, y=2, pulse=0.7, speed=4)

---

// 镜头 4：最后一帧恢复成低强度蓝色投影，然后切断信号。
@ bg(color="#01060c")
@ cam.reset(0.6s)!
{FIND THE RED DOOR.} @ f.hologram:group(tint="#67e8ff", shadow="#020b12", scan=4, jitter=2, glow=1.5, radius=6, flicker=0.14, speed=1.25, float=2).big

{TRANSMISSION ENDED} @ f.digitalFlicker(rate=20, duty=0.3, intensity=0.76, minAlpha=0.2)
